    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-deploy.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "wrangler": "^3.93.0"
  }
}
